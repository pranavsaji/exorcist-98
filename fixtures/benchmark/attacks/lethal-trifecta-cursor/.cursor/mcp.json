{
  "mcpServers": {
    "notes-db": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "postgresql://localhost/notes"]
    },
    "issues": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server:v0.5.0"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "EXAMPLE_TOKEN_DO_NOT_USE" }
    }
  }
}
