# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# Amazon Bedrock (required for M1 heuristic layer)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 bucket for uploaded zips (required for M1 API)
# S3_BUCKET_NAME=

# LiveUpdate (m5-liveupdate). Maintainers only: the path of the Ed25519 signing
# key used by scripts/sign-definitions.ts. Keep the key outside the repository.
# EXORCIST_SIGNING_KEY_FILE=~/.exorcist-98/liveupdate-signing-key.pem
# Where `exorcist update` fetches bundles when --from is not given (https only).
# EXORCIST_UPDATE_URL=https://
# Where installed definition sets live (default ~/.exorcist/definitions).
# EXORCIST_DEFINITIONS_HOME=
