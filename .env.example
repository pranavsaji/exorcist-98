# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# Amazon Bedrock (required for M1 heuristic layer)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 bucket for uploaded zips (required for M1 API)
# S3_BUCKET_NAME=

# LiveUpdate definitions signing key (see scripts/sign-definitions.ts --generate-key)
# EXORCIST_SIGNING_KEY=
# EXORCIST_DEFINITIONS_PUBLIC_KEY=
# EXORCIST_UPDATE_URL=https://
